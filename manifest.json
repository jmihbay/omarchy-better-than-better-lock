{
  "schemaVersion": 1,
  "id": "jmihbay.better-lock",
  "name": "Better Than Better Lock",
  "version": "1.4.0",
  "author": "jmihbay; original by Bibek Bhusal",
  "description": "Theme-following lock with keyboard layout, Caps Lock and configurable wallpaper effects.",
  "homepage": "https://github.com/jmihbay/omarchy-better-than-better-lock",
  "kinds": [
    "service"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml"
  },
  "omarchy": {
    "clonedFrom": "omarchy.lock",
    "capabilities": [
      "authentication"
    ]
  },
  "defaults": {
    "timeFormat": "HH:mm",
    "dateFormat": "dddd, d MMMM",
    "showKeyboardLayout": true,
    "showCapsLock": true,
    "showMedia": false,
    "backgroundDim": 0.15,
    "backgroundBlur": 0.65,
    "backgroundBlurMax": 64,
    "backgroundBlurMultiplier": 1.0,
    "showForgotPassword": true,
    "allowFingerprint": true,
    "screenOffSeconds": 15,
    "suspendSeconds": 45,
    "forgotPasswordScreenOffSeconds": 3.5,
    "language": "auto"
  },
  "schema": [
    {
      "key": "timeFormat",
      "type": "string",
      "label": "timeFormat",
      "defaultValue": "HH:mm"
    },
    {
      "key": "dateFormat",
      "type": "string",
      "label": "dateFormat",
      "defaultValue": "dddd, d MMMM"
    },
    {
      "key": "showKeyboardLayout",
      "type": "boolean",
      "label": "showKeyboardLayout",
      "defaultValue": true
    },
    {
      "key": "showCapsLock",
      "type": "boolean",
      "label": "showCapsLock",
      "defaultValue": true
    },
    {
      "key": "showMedia",
      "type": "boolean",
      "label": "showMedia",
      "defaultValue": false
    },
    {
      "key": "backgroundDim",
      "type": "number",
      "label": "backgroundDim",
      "defaultValue": 0.15
    },
    {
      "key": "backgroundBlur",
      "type": "number",
      "label": "backgroundBlur",
      "defaultValue": 0.65
    },
    {
      "key": "backgroundBlurMax",
      "type": "number",
      "label": "backgroundBlurMax",
      "defaultValue": 64
    },
    {
      "key": "backgroundBlurMultiplier",
      "type": "number",
      "label": "backgroundBlurMultiplier",
      "defaultValue": 1.0
    },
    {
      "key": "showForgotPassword",
      "type": "boolean",
      "label": "Show Forgot password button",
      "defaultValue": true
    },
    {
      "key": "allowFingerprint",
      "type": "boolean",
      "label": "Allow fingerprint unlock",
      "defaultValue": true
    },
    {
      "key": "screenOffSeconds",
      "type": "number",
      "label": "Turn off display after inactivity (seconds)",
      "defaultValue": 15
    },
    {
      "key": "suspendSeconds",
      "type": "number",
      "label": "Suspend after inactivity (seconds)",
      "defaultValue": 45
    },
    {
      "key": "forgotPasswordScreenOffSeconds",
      "type": "number",
      "label": "Turn off display after Forgot password (seconds)",
      "defaultValue": 3.5
    },
    {
      "key": "language",
      "type": "string",
      "label": "Interface language (auto, en, ru)",
      "defaultValue": "auto"
    }
  ]
}
